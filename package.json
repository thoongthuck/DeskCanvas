{
  "name": "DeskCanvas",
  "version": "0.3.3",
  "description": "Infinite canvas wallpaper with sticky notes and file support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:native": "node native/desktop-pin/build.js",
    "build": "electron-builder --publish never"
  },
  "keywords": [
    "wallpaper",
    "canvas",
    "sticky-notes"
  ],
  "author": "",
  "license": "SEE LICENSE IN build/license.txt",
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deskcanvas.app",
    "productName": "DeskCanvas",
    "asarUnpack": [
      "native/**"
    ],
    "files": [
      "**/*",
      "!native/desktop-pin/build/**",
      "!dist/**",
      "!icons/*_미리보기.png",
      "!icons/시안_*.png",
      "!icons/*.md",
      "!.gitignore",
      "!.gitattributes",
      "!build/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "thoongthuck",
        "repo": "DeskCanvas"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/app.ico"
    },
    "nsis": {
      "artifactName": "DeskCanvas-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "installerIcon": "icons/app.ico",
      "uninstallerIcon": "icons/app.ico",
      "installerHeaderIcon": "icons/app.ico",
      "shortcutName": "DeskCanvas",
      "uninstallDisplayName": "DeskCanvas",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
